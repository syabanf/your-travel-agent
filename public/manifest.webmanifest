{
  "id": "/app/",
  "name": "Icon Holiday",
  "short_name": "Icon Holiday",
  "description": "Plan, book and manage your travels with Icon Holiday — your AI travel concierge.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#FBFAF5",
  "theme_color": "#FBFAF5",
  "categories": ["travel", "lifestyle", "navigation"],
  "icons": [
    {
      "src": "/app/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/app/icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/app/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/app/icons/maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Book a trip",
      "short_name": "Book",
      "description": "Search flights, stays and packages",
      "url": "/app/booking",
      "icons": [{ "src": "/app/icons/shortcut-booking.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "My itinerary",
      "short_name": "Trips",
      "description": "Your upcoming trips day by day",
      "url": "/app/itinerary",
      "icons": [{ "src": "/app/icons/shortcut-trips.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "AI assistant",
      "short_name": "Assistant",
      "description": "Ask your travel concierge anything",
      "url": "/app/assistant",
      "icons": [{ "src": "/app/icons/shortcut-assistant.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Deals & promos",
      "short_name": "Deals",
      "description": "Current offers and promo codes",
      "url": "/app/promotions",
      "icons": [{ "src": "/app/icons/shortcut-deals.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
