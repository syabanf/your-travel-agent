{
  "name": "Trip",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Trip Title"
    },
    "destination": {
      "type": "string",
      "title": "Destination"
    },
    "cover_image": {
      "type": "string",
      "title": "Cover Image URL"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "End Date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "planned",
        "active",
        "completed",
        "cancelled"
      ],
      "title": "Status"
    },
    "travelers": {
      "type": "number",
      "title": "Number of Travelers"
    },
    "travel_style": {
      "type": "string",
      "enum": [
        "luxury",
        "adventure",
        "cultural",
        "relaxation",
        "business",
        "family",
        "budget"
      ],
      "title": "Travel Style"
    },
    "budget_total": {
      "type": "number",
      "title": "Total Budget"
    },
    "budget_currency": {
      "type": "string",
      "title": "Currency",
      "default": "USD"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "companions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Companions"
    },
    "shared_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Shared With"
    },
    "is_ai_generated": {
      "type": "boolean",
      "title": "AI Generated"
    },
    "pace": {
      "type": "string",
      "enum": [
        "relaxed",
        "moderate",
        "packed"
      ],
      "title": "Pace"
    },
    "trip_type": {
      "type": "string",
      "enum": [
        "solo",
        "couple",
        "family",
        "business",
        "luxury",
        "group"
      ],
      "title": "Trip Type"
    }
  },
  "required": [
    "title",
    "destination"
  ]
}