{
  "name": "Booking",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string",
      "title": "Trip ID"
    },
    "type": {
      "type": "string",
      "enum": [
        "flight",
        "hotel",
        "train",
        "bus",
        "ship",
        "car_rental",
        "attraction",
        "villa"
      ],
      "title": "Booking Type"
    },
    "title": {
      "type": "string",
      "title": "Booking Title"
    },
    "provider": {
      "type": "string",
      "title": "Provider"
    },
    "check_in": {
      "type": "string",
      "format": "date-time",
      "title": "Check-in / Departure"
    },
    "check_out": {
      "type": "string",
      "format": "date-time",
      "title": "Check-out / Arrival"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "confirmation_code": {
      "type": "string",
      "title": "Confirmation Code"
    },
    "price": {
      "type": "number",
      "title": "Price"
    },
    "currency": {
      "type": "string",
      "title": "Currency",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "completed"
      ],
      "title": "Status"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "voucher_url": {
      "type": "string",
      "title": "Voucher URL"
    },
    "guests": {
      "type": "number",
      "title": "Number of Guests"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL"
    }
  },
  "required": [
    "type",
    "title"
  ]
}