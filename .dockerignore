# Build context hygiene — keep the image small and the layer cache stable.
node_modules
dist
dist-ssr
.git
.gitignore
.github

# local env / editor / OS noise
.env
.env.*
!.env.example
.vscode
.idea
.DS_Store
*.local

# logs & caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
coverage
.vite
.cache

# docs and docker files themselves aren't needed inside the image
Dockerfile
.dockerignore
docker-compose*.yml
*.md
!README.md
